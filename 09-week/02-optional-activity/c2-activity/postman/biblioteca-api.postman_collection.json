        {
          "name": "9. POST datos inválidos - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
            },
            "description": "Título y autor vacíos, ISBN con letras, año inválido. Esperado 400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"\",\n  \"autor\": \"\",\n  \"isbn\": \"ABC\",\n  \"anioPublicacion\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Indica los campos con error\", function () {",
                  "    const campos = pm.response.json().campos;",
                  "    pm.expect(campos).to.have.property(\"titulo\");",
                  "    pm.expect(campos).to.have.property(\"isbn\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10. GET id con formato inválido - 400",
          "request": {
            "method": "GET",
            "header": [],
